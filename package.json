{
	"name": "radiusly",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm routing:build && vite dev",
		"build": "pnpm routing:build && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
		"format": "oxfmt .",
		"lint": "oxlint . && oxfmt --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"routing:build": "tsc -p tsconfig.routing.json",
		"start": "node --env-file-if-exists=.env build",
		"routing:benchmark": "pnpm routing:build && node scripts/benchmark-routing.mjs"
	},
	"dependencies": {
		"@better-auth/core": "1.7.20",
		"@opentelemetry/api": "^1.10.0",
		"better-auth": "1.7.20",
		"leaflet": "^1.9.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24"
	}
}
