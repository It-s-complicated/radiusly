{
	"name": "radiusly",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "oxfmt .",
		"lint": "oxlint . && oxfmt --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"better-auth": "^1.7.1",
		"leaflet": "^1.9.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.2.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.11",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"workbox-window": "^7.4.1"
	},
	"devEngines": {
		"packageManager": {
