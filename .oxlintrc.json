{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error"
	},
	"options": {
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "error"
	},
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"rules": {
				"no-unassigned-vars": "off"
			}
		}
	]
}
